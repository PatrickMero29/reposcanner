# No API key needed — this project no longer calls any paid LLM API.
# The "AI engine" is a locally-trained classifier (see src/vulnscan/training/
# and src/vulnscan/local_model/), which runs on your own GPU/CPU.

# Optional overrides (defaults shown):
# VULNSCAN_MAX_CONCURRENCY=4
# VULNSCAN_DATASET_DB=data/cvefixes.duckdb
# VULNSCAN_OUTPUT_DIR=data/experiments

# CVE retrieval (optional — requires `pip install -e ".[embeddings]"` and
# `vulnscan build-index` first; otherwise these are ignored and retrieval
# just no-ops):
# ENABLE_RETRIEVAL=true
# EMBEDDING_MODEL=flax-sentence-embeddings/st-codesearch-distilroberta-base
# EMBEDDING_INDEX_DIR=data/cve_index
# RETRIEVAL_TOP_K=5

# Semgrep static-analysis pre-filter (optional — requires
# `pip install -e ".[semgrep]"`, or a system-installed `semgrep` on PATH;
# otherwise these are ignored and every function goes straight to the local
# model):
# ENABLE_SEMGREP_PREFILTER=true
# SEMGREP_CONFIG=p/security-audit
# SEMGREP_TIMEOUT=300

# Local trained classifier (optional — requires `pip install -e ".[ml]"` and
# `vulnscan train-model` first; otherwise scanning just uses Semgrep alone):
# LOCAL_MODEL_CHECKPOINT_DIR=models/vuln-classifier
# LOCAL_MODEL_BASE=microsoft/codebert-base
# LOCAL_MODEL_DEVICE=auto
# LOCAL_MODEL_MAX_LENGTH=512
# LOCAL_MODEL_CONFIDENCE_THRESHOLD=0.5
