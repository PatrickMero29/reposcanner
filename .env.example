# Copy this file to .env and fill in your key. Never commit the real .env.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional overrides (defaults shown):
# ANALYZER_MODEL=claude-sonnet-5
# VERIFIER_MODEL=claude-haiku-4-5-20251001
# MAX_OUTPUT_TOKENS=8192
# MODEL_TEMPERATURE=0.0
# VULNSCAN_MAX_RETRIES=5
# VULNSCAN_MAX_CONCURRENCY=4
# VULNSCAN_DATASET_DB=data/cvefixes.duckdb
# VULNSCAN_OUTPUT_DIR=data/experiments

# CVE retrieval (optional — requires `pip install -e ".[embeddings]"` and
# `vulnscan build-index` first; otherwise these are ignored and retrieval
# just no-ops):
# ENABLE_RETRIEVAL=true
# EMBEDDING_MODEL=flax-sentence-embeddings/st-codesearch-distilroberta-base
# EMBEDDING_INDEX_DIR=data/cve_index
# RETRIEVAL_TOP_K=5

# Semgrep static-analysis pre-filter (optional — requires
# `pip install -e ".[semgrep]"`, or a system-installed `semgrep` on PATH;
# otherwise these are ignored and every function goes straight to the AI
# engine, same as before this feature existed):
# ENABLE_SEMGREP_PREFILTER=true
# SEMGREP_CONFIG=auto
# SEMGREP_TIMEOUT=300
